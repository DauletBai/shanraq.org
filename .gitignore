# Binary outputs (anchored to repo root so it does not match pkg/shanraq/)
/shanraq
*.out
/course/rust-organizer/**/target/

# Configuration overrides
config.yaml
.env
.env.*

# Analytics and coverage
coverage.txt

# IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Temporary files
*.tmp
*.temp

# Runtime user media (filesystem MediaStore backend)
/data/

# Local config with real operator/secret values (never commit)
config.local.yaml
configs/config.local.yaml
!.env.example

# Local backup archives (contain data — never commit)
/backups/

# Daily news drafts are temporary working files, not application source code.
# Published articles live in PostgreSQL and must be retained by content backups.
/content/news/

# Python bytecode: written by any run of the course project.
__pycache__/
*.pyc
