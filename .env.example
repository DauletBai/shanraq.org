# Copy to .env and fill in. .env is git-ignored — it holds all secrets.
#   cp .env.example .env
# Used by docker-compose.prod.yml. Values here OVERRIDE configs/config.prod.yaml.

# ---- docker-compose interpolation (not passed verbatim to the app) ----
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
DOMAIN=shanraq.org

# ---- required app secrets / instance settings ----
SHANRAQ_PUBLIC_BASE_URL=https://shanraq.org
SHANRAQ_AUTH_TOKEN_SECRET=change-me-at-least-32-characters-of-random
SHANRAQ_TELEMETRY_METRICS_TOKEN=change-me-random   # protects /metrics
# Browser session lifetime. The default is short (15m); long forms (a listing
# with photos + map) can outlast it and bounce the user to login on submit.
# 2h gives comfortable headroom. Accepts Go durations: 30m, 2h, 24h…
SHANRAQ_AUTH_TOKEN_TTL=2h

# ---- first-run admin (created once on a fresh server, email pre-verified) ----
# Set these for the FIRST boot only; the app creates the admin if none exists,
# then you can remove them. Password must be ≥8 chars.
SHANRAQ_BOOTSTRAP_ADMIN_EMAIL=you@example.com
SHANRAQ_BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
SHANRAQ_BOOTSTRAP_ADMIN_FIRST=Имя
SHANRAQ_BOOTSTRAP_ADMIN_LAST=Фамилия

# ---- legal operator identity (REQUIRED in production; put REAL values only in
#      your private .env — never here, this file is committed) ----
SHANRAQ_OPERATOR_LEGAL_NAME=ТОО «...»
SHANRAQ_OPERATOR_LEGAL_NAME_EN=... LLP
SHANRAQ_OPERATOR_BIN=                    # 12-digit БИН
SHANRAQ_OPERATOR_ADDRESS=               # registered address (RU/KZ)
SHANRAQ_OPERATOR_ADDRESS_EN=            # registered address (EN, optional)
SHANRAQ_OPERATOR_EMAIL=support@shanraq.org

# ---- SMTP (email verification + password reset) ----
# Leave ALL of these blank to keep email OFF. Setting ANY of HOST/FROM/USERNAME/
# PASSWORD turns SMTP "on" and then HOST + FROM become required — so don't fill
# FROM alone. To enable: set HOST, USERNAME, PASSWORD, and FROM together.
SHANRAQ_NOTIFICATIONS_SMTP_HOST=
SHANRAQ_NOTIFICATIONS_SMTP_PORT=587
SHANRAQ_NOTIFICATIONS_SMTP_USERNAME=
SHANRAQ_NOTIFICATIONS_SMTP_PASSWORD=
SHANRAQ_NOTIFICATIONS_SMTP_FROM=              # e.g. Shanraq <no-reply@shanraq.org>

# ---- AI provider keys (optional; active model is chosen in the admin panel) ----
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# KIMI_API_KEY=

# ---- SMS gateway (phone verification for agents/authors) ----
# PROVIDER empty = SMS OFF (codes are dev-logged, never sent; phone verification
# cannot complete in production). Set PROVIDER to "mobizon" or "smsc" and fill the
# matching credentials to turn it on. FROM is the registered sender name (optional).
SHANRAQ_SMS_PROVIDER=            # "" | mobizon | smsc
SHANRAQ_SMS_FROM=               # sender name registered with the operators (optional)
# Mobizon (mobizon.kz):
SHANRAQ_SMS_API_KEY=
# SMSC (smsc.kz):
# SHANRAQ_SMS_LOGIN=
# SHANRAQ_SMS_PASSWORD=
# Delivery channel (smsc): empty = SMS (needs a paid operator sender name);
# "telegram" = deliver codes via Telegram (tg=1) — no sender name, far cheaper.
# SHANRAQ_SMS_CHANNEL=telegram

# ---- Visitor-country analytics (optional) ----
# Path INSIDE the container to a MaxMind-format country DB (DB-IP Lite). The
# compose file bind-mounts ./data/dbip-country.mmdb read-only to this path, so
# the default in config.prod.yaml already points here — override only to move it.
# Empty = country panel off. Only the country code is read; the IP is not stored.
# An optional ASN database (SHANRAQ_ANALYTICS_GEOIP_ASN_DB) flags hosting/cloud/
# VPN traffic as "ЦОД / VPN" so country rows show real readers, not US datacenters.
# Refresh both monthly on the host:
#   M=$(date +%Y-%m)
#   curl -sL https://download.db-ip.com/free/dbip-country-lite-$M.mmdb.gz | gunzip > /opt/shanraq/data/dbip-country.mmdb
#   curl -sL https://download.db-ip.com/free/dbip-asn-lite-$M.mmdb.gz     | gunzip > /opt/shanraq/data/dbip-asn.mmdb
#   docker compose -f docker-compose.prod.yml restart app
# SHANRAQ_ANALYTICS_GEOIP_DB=/app/geoip/country.mmdb
# SHANRAQ_ANALYTICS_GEOIP_ASN_DB=/app/geoip/asn.mmdb
